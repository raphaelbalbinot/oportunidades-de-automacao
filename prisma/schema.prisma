// Prisma Schema para Oportunidades de Automação
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Parametro {
  id                             String   @id @default("singleton")
  
  // Matriz de Benefícios Estratégicos Corporativos (12 Critérios Universais)
  pesoLiberarPessoas             Float    @default(3.0) // Liberar Capacidade Humana / Realocação de Pessoas
  pesoReduzirCusto               Float    @default(3.0) // Redução de Custos Operacionais
  pesoReduzirErros               Float    @default(3.0) // Redução de Erros Operacionais
  pesoSegurancaPrivacidade       Float    @default(3.0) // Segurança da Informação & Privacidade de Dados
  pesoRastreabilidadeCompliance  Float    @default(3.0) // Rastreabilidade & Conformidade (Compliance Empresarial)
  pesoKeyPersonRisk              Float    @default(2.0) // Mitigação de Dependência de Pessoas (Key-Person Risk)
  pesoMelhorarExpCliente         Float    @default(2.0) // Experiência do Cliente / Usuário
  pesoAumentarCapacidade         Float    @default(2.0) // Aumento de Capacidade Operacional & Escalabilidade
  pesoReduzirTempoResposta       Float    @default(2.0) // Redução do Tempo de Resposta (SLA)
  pesoInteroperabilidade         Float    @default(2.0) // Interoperabilidade & Integração entre Sistemas
  pesoTransformacaoDigital       Float    @default(1.0) // Transformação Digital & Inovação
  pesoSustentabilidadeEsg        Float    @default(1.0) // Sustentabilidade Operacional (ESG)
  pesoReduzirFte                 Float    @default(0.0) // Legado unificado em pesoLiberarPessoas

  // Carga Horária Padrão
  cargaHorariaPadrao             Float    @default(160.0) // HH/mês

  // Infraestrutura Robótica Padrão / Sustentação
  operadorSalaControle           Float    @default(7500.0) // Posto de sustentação NOC 24x7 com encargos
  servidor                       Float    @default(1150.70) // VM / Cluster Nuvem Corporativa
  licencaRobo                    Float    @default(0.0)     // Licença padrão (Open Source = 0)
  estacaoTrabalhoRobo            Float    @default(0.0)     // Estação de trabalho dedicada
  nrRobos                        Float    @default(5.0)     // Quantidade de robôs no parque para rateio

  // Distribuição Percentual de Custo por Turno
  percDiurno                     Float    @default(0.60)
  percNoturno                    Float    @default(0.30)
  percFimDeSemana                Float    @default(0.10)

  // Investimento de Engenharia / Desenvolvimento por Salário Mensal (R$/Mês)
  salarioDesenvolvedorI          Float    @default(10000.0) // Desenvolvedor I (Júnior)
  salarioDesenvolvedorII         Float    @default(18500.0) // Desenvolvedor II (Pleno)
  salarioDesenvolvedorIII        Float    @default(26000.0) // Desenvolvedor III (Sênior)
  custoHoraDesenvolvimento       Float    @default(185.0)   // Legado / Fallback

  // Parâmetros Financeiros Corporativos (VPL & Benchmarks)
  taxaDescontoVpl                Float    @default(0.12)  // 12% a.a. taxa de desconto padrão
  horizonteVplMeses              Float    @default(36.0)  // 36 meses = 3 anos

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model Area {
  id                             String   @id @default(uuid())
  nome                           String   @unique
  sigla                          String   @default("")
  responsavel                    String   @default("")
  descricao                      String   @default("")
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model PerfilPlataforma {
  id                             String   @id @default(uuid())
  nome                           String
  categoria                      String   @default("Open Source / Scripting") // "Open Source / Scripting", "Workflow & iPaaS", "RPA Proprietário", "Low-Code / RAD"
  descricao                      String   @default("")
  custoLicencaMensal             Float    @default(0.0)
  custoEstacaoTrabalho           Float    @default(0.0)
  custoServidor                  Float    @default(1150.70)
  nrRobosDiluicao                Float    @default(5.0)
  isPadrao                       Boolean  @default(false)
  
  registros                      Registro[]
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model Registro {
  id                             String   @id @default(uuid())
  
  // Identificação & Contexto
  idOrigem                       String   @default("")
  idAnalise                      String   @default("P1")
  area                           String   @default("")
  nomeProcesso                   String
  dataLevantamento               String   @default("")
  participantes                  String   @default("")
  situacao                       String   @default("Em levantamento") // "Em levantamento", "Aprovado", "Em implantação", "Concluído", "Descartado"

  // Funil de Maturidade FCAIA (N0 a N3)
  nivelMaturidade                String   @default("N0") // "N0", "N1", "N2", "N3"
  dataPromocaoMaturidade         String   @default("")
  responsavelPromocao            String   @default("")
  isRetrospectivo                Boolean  @default(false)

  // Triagem Qualitativa N0
  sintomasDor                    String   @default("")
  papeisEnvolvidos               String   @default("")
  criticidadePercebida           String   @default("Média") // "Baixa", "Média", "Alta", "Crítica"
  recorrenciaDor                 String   @default("Frequente") // "Rara", "Ocasional", "Frequente", "Diária"

  // 7 Arquétipos de Processo
  arquetipoPrimario              String   @default("A1") // "A1", "A2", "A3", "A4", "A5", "A6", "A7"
  arquetiposSecundarios          String   @default("")   // ex: "A2,A4"

  // Variáveis Quantitativas Específicas por Arquétipo
  // A1 - Transacional repetitivo
  percAutomatizavel              Float    @default(1.0)

  // A2 - Erro e retrabalho
  taxaErroAtual                  Float    @default(0.0)
  custoMedioErro                 Float    @default(0.0)
  reducaoEsperadaErro            Float    @default(0.8)

  // A3 - Atendimento e autosserviço
  volumeContatosMensal           Float    @default(0.0)
  custoAtendimentoHumano         Float    @default(0.0)
  taxaContencaoEsperada          Float    @default(0.0)
  custoAtendimentoAuto           Float    @default(0.0)

  // A4 - Conformidade e risco contratual
  probabilidadeDescumprimento    Float    @default(0.0)
  impactoFinanceiroOcorrencia    Float    @default(0.0)
  reducaoProbabilidadeRisco      Float    @default(0.0)
  historicoOcorrencias12m        Float    @default(0.0)

  // A5 - Gargalo, lead time e ciclo de receita
  leadTimeAtualDias              Float    @default(0.0)
  leadTimeProjetadoDias          Float    @default(0.0)
  volumeAdicionalViabilizado     Float    @default(0.0)
  ticketMedioReceita             Float    @default(0.0)
  diasAntecipacaoFaturamento     Float    @default(0.0)
  valorFaturadoCiclo             Float    @default(0.0)

  // A6 - Racionalização de ativos técnicos
  nrAtivosAntes                  Float    @default(0.0)
  nrAtivosDepois                 Float    @default(0.0)
  custoManutencaoAnualAtivo      Float    @default(0.0)

  // A7 - Processo comercial e oportunidade
  numSolicitacoesComerciaisMes   Float    @default(0.0)
  tempoRespostaAtualHoras        Float    @default(0.0)
  tempoRespostaAlvoHoras         Float    @default(0.0)
  taxaConversaoAtual             Float    @default(0.0)
  taxaConversaoAlvo              Float    @default(0.0)
  ticketMedioProposta            Float    @default(0.0)
  percPerdasPorPrazo             Float    @default(0.0)

  // Atribuição por Trilha (Seção 5.3)
  percTrilhaProcesso             Float    @default(0.0)
  percTrilhaSistema              Float    @default(0.0)
  percTrilhaAutomacao            Float    @default(1.0)
  justificativaTrilha            String   @default("")

  // Fator de Reuso e Escala (Seção 5.4)
  unidadesPiloto                 Float    @default(1.0)
  unidadesPotenciais             Float    @default(1.0)
  custoMarginalReplicacao        Float    @default(0.0)
  beneficioPotencialEscala       Float    @default(0.0)

  // Baseline Incremental (Seção 5.5)
  coberturaInicialPerc           Float    @default(0.0)
  coberturaFinalPerc             Float    @default(1.0)

  // AS IS (Situação Atual)
  areasEnvolvidas                String   @default("")
  descricaoProcesso              String   @default("")
  numExecucoes                   Float    @default(0.0)
  periodicidade                  String   @default("Mensal") // "Diária", "Semanal", "Mensal", "Sob demanda"
  numPessoasEnvolvidas           Float    @default(1.0)
  tipoAlocacao                   String   @default("Parcial") // "Dedicada", "Parcial"
  perfilExecutor                 String   @default("Analista")
  valorHoraExecutor              Float    @default(0.0)
  tempoExecucao                  Float    @default(0.0) // horas/mês
  custoMensalAtual               Float    @default(0.0)
  sistemasEnvolvidos             String   @default("")
  documentosApoio                String   @default("")

  // TO BE - Matriz de Benefícios (12 Critérios Corporativos)
  benLiberarPessoas              String   @default("nenhum")
  benReduzirCusto                String   @default("nenhum")
  benReduzirErros                String   @default("nenhum")
  benSegurancaPrivacidade        String   @default("nenhum")
  benRastreabilidadeCompliance   String   @default("nenhum")
  benKeyPersonRisk               String   @default("nenhum")
  benMelhorarExpCliente          String   @default("nenhum")
  benAumentarCapacidade          String   @default("nenhum")
  benReduzirTempoResposta        String   @default("nenhum")
  benInteroperabilidade          String   @default("nenhum")
  benTransformacaoDigital        String   @default("nenhum")
  benSustentabilidadeEsg         String   @default("nenhum")
  benReduzirFte                  String   @default("nenhum")
  pontuacaoBeneficios            Float    @default(0.0)

  // TO BE - Solução Técnica e Plataforma
  perfilPlataformaId             String?
  perfilPlataforma               PerfilPlataforma? @relation(fields: [perfilPlataformaId], references: [id])
  tipoPlataformaNome             String   @default("Python & Robot Framework (Open Source)")
  
  descricaoSolucao               String   @default("")
  pontosAtencao                  String   @default("")
  fteLiberado                    Float    @default(0.0)
  reducaoTempoPrevista           String   @default("0%")
  complexidade                   String   @default("Média") // "Baixa", "Média", "Alta"
  reducaoCustoPrevista           String   @default("0%")
  numRotinas                     Float    @default(1.0)
  turno                          String   @default("Diurno")
  recomendacao                   String   @default("Recomendado")

  // Custo, Esforço e Alocação de Múltiplos Turnos
  perfilDesenvolvedor            String   @default("Desenvolvedor II") // "Desenvolvedor I", "Desenvolvedor II", "Desenvolvedor III"
  esforcoSetupSemanas            Float    @default(1.0)
  investimentoSetup              Float    @default(0.0)
  
  horasRoboDiurno                Float    @default(0.0)
  horasRoboNoturno               Float    @default(0.0)
  horasRoboFimDeSemana           Float    @default(0.0)
  horasRobo                      Float    @default(0.0)
  
  custoHorasRobo                 Float    @default(0.0)
  horasApoioNegocio              Float    @default(0.0)
  custoHorasNegocio              Float    @default(0.0)
  horasManutencao                Float    @default(0.0)
  custoManutencao                Float    @default(0.0)

  // Totais Mensais e Anuais
  custoMensalAno1                Float    @default(0.0)
  custoMensalAno2                Float    @default(0.0)
  custoAnualAno1                 Float    @default(0.0)
  custoAnualAno2                 Float    @default(0.0)

  // Benefícios Bruto e Líquido por Arquétipo
  beneficioBrutoAnual            Float    @default(0.0)
  beneficioLiquidoAnual          Float    @default(0.0)

  // ROI, Payback & Priorização
  roiAno1                        Float    @default(0.0)
  roiAno2                        Float    @default(0.0)
  paybackMeses                   Float    @default(0.0)
  scorePriorizacao               Float    @default(0.0)

  // VPL & Cenários
  vpl3Anos                       Float    @default(0.0)
  vplCenarioConservador          Float    @default(0.0)
  vplCenarioBase                 Float    @default(0.0)
  vplCenarioOtimista             Float    @default(0.0)
  paybackCenarioConservador      Float    @default(0.0)
  paybackCenarioOtimista         Float    @default(0.0)

  // N3 - Benefício Realizado
  beneficioRealizadoAnual        Float    @default(0.0)
  desvioProjetadoRealizadoPerc   Float    @default(0.0)
  dataApuracaoRealizado          String   @default("")
  notasRealizado                 String   @default("")

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}
